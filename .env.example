PORT=3000
# Render: https://your-service.onrender.com (no trailing slash)
PUBLIC_ORIGIN=
# Optional external TURN server. Never deploy TURN inside this Render service.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Shared cloud sticker library (optional; upload is disabled until configured)
SUPABASE_URL=
# Server-only service_role key. Set this in Render Environment; never expose in VITE_*.
SUPABASE_SERVICE_ROLE_KEY=
EMOJI_BUCKET=friends-live-emojis
